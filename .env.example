# Copy to .env and edit. Everything has a working default except the keys.

# --- database --------------------------------------------------------------
# SQLite for local development; docker compose overrides this with Postgres.
# DATABASE_URL=postgresql+psycopg://urjapod:urjapod@localhost:5432/urjapod

# --- extraction ------------------------------------------------------------
# The one switch that decides which document-understanding backend runs.
#   manual             — a form, no model at all. Always works.
#   openai_compatible  — Ollama / vLLM / LM Studio on localhost.
#   anthropic          — the cloud adapter.
EXTRACTOR=manual

# Local model (no key needed, no internet needed)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:14b

# Cloud model (optional)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Below this confidence the review screen will not let a one-click approve happen.
EXTRACTION_REVIEW_THRESHOLD=0.80

# --- tally -----------------------------------------------------------------
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY_NAME=Urjapod Energy Private Limited

# Set to true ONLY when served over HTTPS. On a plain-HTTP office LAN a
# Secure cookie is never sent and nobody can stay signed in.
SESSION_COOKIE_SECURE=false
